name: weekly-bar-radar

on:
  schedule:
    - cron: "0 4 * * 1" # Her Pazartesi sabah 04:00 UTC (Almanya'da 05:00/06:00)
  workflow_dispatch: # Manuel tetikleme butonu ekler

permissions:
  contents: write # push için gerekli

jobs:
  run-radar:
    runs-on: ubuntu-latest
    steps:
      - name: Repoyu Klonla
        uses: actions/checkout@v4

      - name: Python Kur
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Botu Çalıştır
        env:
          APIFY_TOKEN: ${{ secrets.APIFY_TOKEN }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
        run: python scripts/radar.py

      - name: Değişiklikleri Kaydet ve Pushla
        run: |
          git config --global user.name "GitHub Actions"
          git config --global user.email "actions@github.com"
          git add state.json docs/results.json
          git commit -m "Radar güncellendi" || echo "Değişiklik yok"
          git push
